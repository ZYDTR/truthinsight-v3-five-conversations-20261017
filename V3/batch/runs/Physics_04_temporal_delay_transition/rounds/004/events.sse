data: {"type": "message.updated", "sequence": 1021, "run_id": "run_75dcde02c7154d1a", "data": {"id": "ae24ed0b-095f-472e-b539-af980bd60af3", "run_id": "run_75dcde02c7154d1a", "kind": "tool", "position": 1019, "revision": 1021, "parent_tool_use_id": null, "agent_call_id": null, "data": {"name": "Read", "input": "{\"file_path\": \"[workspace]\", \"offset\": 83, \"limit\": 30}", "status": "running", "tool_use_id": "call_104f8e5b768b4aab827f6577"}, "created_at": "2026-10-16T09:38:08.163799+00:00", "updated_at": "2026-10-16T09:38:08.565562+00:00"}}

