alysis.py\"\n        ],\n        \"result_evidence\": [\n          \"evidence/finding1_V_vs_B.json\",\n          \"evidence/finding1_v_b_scatter.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": true\n      },\n      {\n        \"finding_number\": 2,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [\n          \"analysis.py\"\n        ],\n        \"result_evidence\": [\n          \"evidence/finding2_correlation_collapse.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": true\n      },\n      {\n        \"finding_number\": 3,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [\n          \"analysis.py\"\n        ],\n        \"result_evidence\": [\n          \"evidence/finding3_finite_size.json\",\n          \"evidence/robustness_checks.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": true\n      },\n      {\n        \"finding_number\": 4,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [\n          \"analysis.py\"\n        ],\n        \"result_evidence\": [\n          \"evidence/finding4_real_networks.json\",\n          \"evidence/robustness_checks.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": true\n      }\n    ]\n  },\n  \"reproduction\": {\n    \"mode\": \"companion_markdown\",\n    \"document\": {\n      \"path\": \"reproduce.md\",\n      \"bytes\": 2316,\n      \"sha256\": \"58ef81d87ca69d676208cbe97a47ce92d7a36f803d49b0646b6d154fe880da61\"\n    }\n  },\n  \"analysis_sources\": [\n    {\n      \"path\": \"analysis.py\",\n      \"bytes\": 20772,\n      \"sha256\": \"62081bd1110fe0635a428deccfa3f153d124080ad08e269b85a90466f87f6cc0\"\n    },\n    {\n      \"path\": \"robustness.py\",\n      \"bytes\": 11028,\n      \"sha256\": \"82e67c8a672348adc1f8f222a5864be12ed399e1c3b1d9adc40115d84bf72e50\"\n    }\n  ],\n  \"executed_notebooks\": [],\n  \"result_artif