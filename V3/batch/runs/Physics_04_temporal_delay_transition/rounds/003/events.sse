id: 791
event: message.updated
data: {"type": "message.updated", "sequence": 791, "run_id": "run_caff408c4d634db7", "data": {"id": "3c4384ac-6385-4f47-a027-112408347451", "run_id": "run_caff408c4d634db7", "kind": "tool", "position": 787, "revision": 791, "parent_tool_use_id": null, "agent_call_id": null, "data": {"name": "Read", "input": "{\"file_path\": \"[workspace]\"}", "output": "1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tRobustness checks and figure generation for Physics_04_temporal_delay_transition\n4\t\"\"\"\n5\t\n6\timport numpy as np\n7\timport pandas as pd\n8\tfrom scipy import stats, optimize\n9\timport json\n10\timport os\n11\t\n12\tDATA_DIR = 'data/source_data'\n13\tOUTPUT_DIR = 'output/evidence'\n14\tos.makedirs(OUTPUT_DIR, exist_ok=True)\n15\t\n16\t# ============================================================\n17\t# Robustness Check 1: Finding 1 - Leave-one-out segmentation\n18\t# ============================================================\n19\tprint(\"Robustness Check 1: Segmented regression stability\")\n20\t\n21\tth = pd.read_csv(f'{DATA_DIR}/figures/fig2_critical_buffer/data/theory_data.csv')\n22\tbest_Bc = None\n23\tbest_diff = -np.inf\n24\tfor Bc_candidate in np.arange(0.5, 4.0, 0.05):\n25\t    mask_below = th['B'] < Bc_candidate\n26\t    mask_above = th['B'] >= Bc_candidate\n27\t    if mask_below.sum() < 5 or mask_above.sum() < 5:\n28\t        continue\n29\t    s1, _, _, _, _ = stats.linregress(th.loc[mask_below, 'B'], th.loc[mask_below, 'V'])\n30\t    s2, _, _, _, _ = stats.linregress(th.loc[mask_above, 'B'], th.loc[mask_above, 'V'])\n31\t    diff = abs(s2 - s1)\n32\t    if diff > best_diff:\n33\t        best_diff = diff\n34\t        best_Bc = Bc_candidate\n35\t\n36\t# Leave-one-out: remove each point and re-check Bc\n37\tBc_stability = []\n38\tfor i in range(len(th)):\n39\t    th_loo = th.drop(i)\n40\t    for Bc_candidate in np.arange(0.5, 4.0, 0.05):\n41\t        mask_below = th_loo['B'] < Bc_candidate\n42\t        mask_above = th_loo['B'] >= Bc_candidate\n43\t        if mask_below.sum() < 5 or mask_above.sum() < 5:\n44\t            continue\n45\t        s1, _, _, _, _ = stats.linregress(th_loo.loc[mask_below, 'B'], th_loo.loc[mask_below, 'V'])\n46\t        s2, _, _, _, _ = stats.linregress(th_loo.loc[mask_above, 'B'], th_loo.loc[mask_above, 'V'])\n47\t        diff = abs(s2 - s1)\n48\t        if diff > best_diff * 0.9:  # near-optimal\n49\t            Bc_stability.append(float(Bc_candidate))\n50\t            break\n51\t\n52\tif Bc_stability:\n53\t    print(f\"  Original Bc: {best_Bc:.2f}\")\n54\t    print(f\"  LOO Bc range: [{min(Bc_stability):.2f}, {max(Bc_stability):.2f}], mean={np.mean(Bc_stability):.2f}\")\n55\telse:\n56\t    print(f\"  Original Bc: {best_Bc:.2f} (stable)\")\n57\t\n58\t# ============================================================\n59\t# Robustness Check 2: Finding 2 - Collapse with different interpolation\n60\t# ============================================================\n61\tprint(\"\\nRobustness Check 2: Correlation collapse robustness\")\n62\t\n63\tcorrelations = {}\n64\tfor i in range(1, 6):\n65\t    fn = f'{DATA_DIR}/figures/fig3a_correlation_collapse/data/corr.ave_{i}.txt'\n66\t    c = pd.read_csv(fn, sep=r'\\s+', header=None, names=['lag', 'acf'])\n67\t    correlations[f'B{i}'] = c\n68\t\n69\t# Test with cubic spline instead of linear\n70\tfrom scipy.interpolate import CubicSpline\n71\tkeys = list(correlations.keys())\n72\tcollapse_spline = {}\n73\tfor i in range(len(keys)):\n74\t    for j in range(i+1, len(keys)):\n75\t        k1, k2 = keys[i], keys[j]\n76\t        c1, c2 = correlations[k1], correlations[k2]\n77\t\n78\t        cs = CubicSpline(c2['lag'].values, c2['acf'].values)\n79\t        best_s = None\n80\t        best_c = -2\n81\t        for scale in np.arange(0.1, 10.0, 0.05):\n82\t            y = cs(c1['lag'].values * scale)\n83\t            if np.all(np.isfinite(y)) and np.any(np.isfinite(c1['acf'].values)):\n84\t                c_val = np.corrcoef(c1['acf'].values, y)[0, 1]\n85\t                if c_val > best_c:\n86\t                    best_c = c_val\n87\t                    best_s = scale\n88\t\n89\t        collapse_spline[f\"{k1}_vs_{k2}\"] = {\n90\t            'optimal_scale': float(best_s) if best_s else None,\n91\t            'max_correlation': float(best_c) if best_c > -1 else None\n92\t        }\n93\t\n94\t# Compare linear vs spline results\n95\tprint(\"  Linear vs Spline collapse comparison:\")\n96\tfor key in collapse_spline:\n97\t    lin_corr = 0\n98\t    spl_corr = collapse_spline[key]['max_correlation']\n99\t    print(f\"    {key}: spline corr={spl_corr:.6f}\")\n100\t\n101\t# ============================================================\n102\t# Robustness Check 3: Finding 3 - Bootstrap confidence intervals\n103\t# ============================================================\n104\tprint(\"\\nRobustness Check 3: Finite-size scaling bootstrap\")\n105\t\n106\tN_vals = pd.read_csv(f'{DATA_DIR}/figures/SI.2_finite_size/data/N_values.csv', header=None, names=['N'])\n107\tBc_mf = pd.read_csv(f'{DATA_DIR}/figures/SI.2_finite_size/data/meanfield_Bc.csv', header=None, names=['Bc'])\n108\tBc_tn = pd.read_csv(f'{DATA_DIR}/figures/SI.2_finite_size/data/tempnet_Bc.csv', header=None, names=['Bc'])\n109\t\n110\tN = N_vals['N'].values\n111\tBc_meanfield = Bc_mf['Bc'].values\n112\tBc_tempnet = Bc_tn['Bc'].values\n113\t\n114\t# Bootstrap for meanfield\n115\tnp.random.seed(42)\n116\tn_bootstrap = 1000\n117\tBc_inf_boot = []\n118\tnu_boot = []\n119\t\n120\tfor b in range(n_bootstrap):\n121\t    idx = np.random.choice(len(N), size=len(N), replace=True)\n122\t    N_b = N[idx]\n123\t    Bc_b = Bc_meanfield[idx]\n124\t\n125\t    best_nu_b = None\n126\t    best_r2_b = -np.inf\n127\t    best_intercept_b = None\n128\t\n129\t    for nu in np.arange(0.5, 5.0, 0.05):\n130\t        x = N_b**(-1.0/nu)\n131\t        slope, intercept, r, p, se = stats.linregress(x, Bc_b)\n132\t        if r**2 > best_r2_b:\n133\t            best_r2_b = r**2\n134\t            best_nu_b = nu\n135\t            best_intercept_b = intercept\n136\t\n137\t    if best_nu_b is not None:\n138\t        Bc_inf_boot.append(best_intercept_b)\n139\t        nu_boot.append(best_nu_b)\n140\t\n141\tif Bc_inf_boot:\n142\t    print(f\"  Meanfield Bc_inf: mean={np.mean(Bc_inf_boot):.6f}, \"\n143\t          f\"95%CI=[{np.percentile(Bc_inf_boot, 2.5):.6f}, {np.percentile(Bc_inf_boot, 97.5):.6f}]\")\n144\t    print(f\"  Meanfield nu: mean={np.mean(nu_boot):.2f}, \"\n145\t          f\"95%CI=[{np.percentile(nu_boot, 2.5):.2f}, {np.percentile(nu_boot, 97.5):.2f}]\")\n146\t\n147\t# ============================================================\n148\t# Robustness Check 4: Finding 4 - Alternative model for real networks\n149\t# ============================================================\n150\tprint(\"\\nRobustness Check 4: Real-network alternative models\")\n151\t\n152\tthiers13 = pd.read_csv(f'{DATA_DIR}/figures/fig4b_RW_networks/fig_source_data/Thiers13_source_data.csv')\n153\tworkplace15 = pd.read_csv(f'{DATA_DIR}/figures/fig4b_RW_networks/fig_source_data/Workplace15_source_data.csv')\n154\t\n155\tthiers_B = thiers13['buffer_lin_Thiers13'].values\n156\tthiers_D = thiers13['Thiers13_delays'].values\n157\twp_B = workplace15['buffer_log_Workplace15'].values\n158\twp_D = workplace15['Workplace15_delays'].values\n159\t\n160\t# Exponential decay: D = a * exp(-b*B)\n161\tmask_thiers_nonzero = thiers_B > 0\n162\tif mask_thiers_nonzero.sum() > 2:\n163\t    from scipy.optimize import curve_fit\n164\t    def exp_decay(x, a, b):\n165\t        return a * np.exp(-b * x)\n166\t    try:\n167\t        popt, pcov = curve_fit(exp_decay, thiers_B[mask_thiers_nonzero], thiers_D[mask_thiers_nonzero])\n168\t        residuals = thiers_D[mask_thiers_nonzero] - exp_decay(thiers_B[mask_thiers_nonzero], *popt)\n169\t        ss_res = np.sum(residuals**2)\n170\t        ss_tot = np.sum((thiers_D[mask_thiers_nonzero] - np.mean(thiers_D[mask_thiers_nonzero]))**2)\n171\t        r2_exp = 1 - ss_res/ss_tot\n172\t        print(f\"  Thiers13 exponential: R²={r2_exp:.6f}, params={popt}\")\n173\t    except Exception as e:\n174\t        print(f\"  Thiers13 exponential fit failed: {e}\")\n175\t\n176\t# Quadratic fit\n177\ttry:\n178\t    quad_coeffs = np.polyfit(thiers_B, thiers_D, 2)\n179\t    quad_pred = np.polyval(quad_coeffs, thiers_B)\n180\t    ss_res = np.sum((thiers_D - quad_pred)**2)\n181\t    ss_tot = np.sum((thiers_D - np.mean(thiers_D))**2)\n182\t    r2_quad = 1 - ss_res/ss_tot\n183\t    print(f\"  Thiers13 quadratic: R²={r2_quad:.6f}, coeffs={quad_coeffs}\")\n184\texcept Exception as e:\n185\t    print(f\"  Thiers13 quadratic fit failed: {e}\")\n186\t\n187\t# ============================================================\n188\t# Save robustness results\n189\t# ============================================================\n190\trobustness = {\n191\t    'finding1_segmentation': {\n192\t        'original_Bc': float(best_Bc),\n193\t        'loo_stability': {\n194\t            'range': [float(min(Bc_stability)), float(max(Bc_stability))] if Bc_stability else ['stable'],\n195\t            'mean': float(np.mean(Bc_stability)) if Bc_stability else float(best_Bc)\n196\t        }\n197\t    },\n198\t    'finding2_collapse_spline': collapse_spline,\n199\t    'finding3_bootstrap': {\n200\t        'Bc_inf_mean': float(np.mean(Bc_inf_boot)) if Bc_inf_boot else None,\n201\t        'Bc_inf_CI_95': [float(np.percentile(Bc_inf_boot, 2.5)), float(np.percentile(Bc_inf_boot, 97.5))] if Bc_inf_boot else None,\n202\t        'nu_mean': float(np.mean(nu_boot)) if nu_boot else None,\n203\t        'nu_CI_95': [float(np.percentile(nu_boot, 2.5)), float(np.percentile(nu_boot, 97.5))] if nu_boot else None\n204\t    },\n205\t    'finding4_alternative_models': {\n206\t        'Thiers13_quadratic_R2': float(r2_quad) if 'r2_quad' in dir() else None\n207\t    }\n208\t}\n209\t\n210\twith open(f'{OUTPUT_DIR}/robustness_checks.json', 'w') as f:\n211\t    json.dump(robustness, f, indent=2)\n212\t\n213\tprint(\"\\nRobustness checks saved to output/evidence/robustness_checks.json\")\n214\t", "status": "completed", "is_async": false, "tool_use_id": "call_623ab12feb9b44e2ba78b18c"}, "created_at": "2026-10-16T09:27:29.608915+00:00", "updated_at": "2026-10-16T09:27:30.087896+00:00"}}

