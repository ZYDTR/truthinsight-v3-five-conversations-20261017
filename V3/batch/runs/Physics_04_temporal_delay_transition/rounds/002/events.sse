fer-dependent delay consistent with simulated predictions\",\n        \"heading_level\": 3\n      }\n    ],\n    \"traceability\": [\n      {\n        \"finding_number\": 1,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [],\n        \"result_evidence\": [\n          \"evidence/finding1_V_vs_B.json\",\n          \"evidence/finding1_v_b_scatter.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": false\n      },\n      {\n        \"finding_number\": 2,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [],\n        \"result_evidence\": [\n          \"evidence/finding2_correlation_collapse.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": false\n      },\n      {\n        \"finding_number\": 3,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [],\n        \"result_evidence\": [\n          \"evidence/finding3_finite_size.json\",\n          \"evidence/robustness_checks.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": false\n      },\n      {\n        \"finding_number\": 4,\n        \"resolved_native_tokens\": [],\n        \"analysis_sources\": [],\n        \"result_evidence\": [\n          \"evidence/finding4_real_networks.json\"\n        ],\n        \"executed_notebook_evidence\": [],\n        \"passed\": false\n      }\n    ]\n  },\n  \"reproduction\": {\n    \"mode\": \"companion_markdown\",\n    \"document\": {\n      \"path\": \"reproduce.md\",\n      \"bytes\": 1803,\n      \"sha256\": \"c019c07129edaabfc5ab21c68e712a73cfec79d11a8d8496076b51c0f5f87d4c\"\n    }\n  },\n  \"analysis_sources\": [],\n  \"executed_notebooks\": [],\n  \"result_artifacts\": [\n    {\n      \"path\": \"evidence/finding1_V_vs_B.json\",\n      \"bytes\": 752,\n      \"sha256\": \"fe3eae276299a08637cfe6ecd598b522505cfa6ab6b6a59d17576d3ba6157a0d\"\n    },\n    {\n      \"path\": \"evidence/finding1_v_b_scatter.json\",\n     