ax_correlation_with_reference\": 0.9999634858110125\n46\t      },\n47\t      \"ave_3\": {\n48\t        \"optimal_scale\": 0.14954954954954958,\n49\t        \"max_correlation_with_reference\": 0.9999410701632467\n50\t      },\n51\t      \"ave_4\": {\n52\t        \"optimal_scale\": 0.1,\n53\t        \"max_correlation_with_reference\": 0.989575222885112\n54\t      },\n55\t      \"ave_5\": {\n56\t        \"optimal_scale\": 0.1,\n57\t        \"max_correlation_with_reference\": 0.9488974550615642\n58\t      }\n59\t    },\n60\t    \"all_pairwise_correlations\": {\n61\t      \"ave_1_vs_ave_2\": {\n62\t        \"optimal_scale\": 0.35765765765765767,\n63\t        \"correlation\": 0.9999634858110125\n64\t      },\n65\t      \"ave_1_vs_ave_3\": {\n66\t        \"optimal_scale\": 0.14954954954954958,\n67\t        \"correlation\": 0.9999410701632467\n68\t      },\n69\t      \"ave_1_vs_ave_4\": {\n70\t        \"optimal_scale\": 0.1,\n71\t        \"correlation\": 0.989575222885112\n72\t      },\n73\t      \"ave_1_vs_ave_5\": {\n74\t        \"optimal_scale\": 0.1,\n75\t        \"correlation\": 0.9488974550615642\n76\t      },\n77\t      \"ave_2_vs_ave_3\": {\n78\t        \"optimal_scale\": 0.40720720720720727,\n79\t        \"correlation\": 0.9999884030361186\n80\t      },\n81\t      \"ave_2_vs_ave_4\": {\n82\t        \"optimal_scale\": 0.17927927927927928,\n83\t        \"correlation\": 0.9999627907012163\n84\t      },\n85\t      \"ave_2_vs_ave_5\": {\n86\t        \"optimal_scale\": 0.1,\n87\t        \"correlation\": 0.9978458957301573\n88\t      },\n89\t      \"ave_3_vs_ave_4\": {\n90\t        \"optimal_scale\": 0.436936936936937,\n91\t        \"correlation\": 0.9999837615222115\n92\t      },\n93\t      \"ave_3_vs_ave_5\": {\n94\t        \"optimal_scale\": 0.20900900900900904,\n95\t        \"correlation\": 0.9999158730675178\n96\t      },\n97\t      \"ave_4_vs_ave_5\": {\n98\t        \"optimal_scale\": 0.4666666666666667,\n99\t        \"correlation\": 0.9999689904402599\n100\t      }