data: {"type": "message.updated", "sequence": 1034, "run_id": "run_6be133d109564be9", "data": {"id": "5f21361c-bc5c-4725-b404-5acea6f18fde", "run_id": "run_6be133d109564be9", "kind": "tool", "position": 1034, "revision": 1034, "parent_tool_use_id": null, "agent_call_id": null, "data": {"name": "Read", "status": "running", "tool_use_id": "call_dd5f611a0a0c4d399a5ab9eb"}, "created_at": "2026-10-16T09:18:46.194344+00:00", "updated_at": "2026-10-16T09:18:46.194349+00:00"}}

