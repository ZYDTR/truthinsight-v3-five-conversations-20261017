data: {"type": "message.updated", "sequence": 1364, "run_id": "run_673a78c0aab44914", "data": {"id": "bcefbd6f-bb78-4939-b28b-72cbd20b0604", "run_id": "run_673a78c0aab44914", "kind": "tool", "position": 1364, "revision": 1364, "parent_tool_use_id": null, "agent_call_id": null, "data": {"name": "Bash", "status": "running", "tool_use_id": "call_ab5269a512664e9c84c27980"}, "created_at": "2026-10-16T09:35:21.477864+00:00", "updated_at": "2026-10-16T09:35:21.477876+00:00"}}

